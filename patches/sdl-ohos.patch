diff --git a/src/core/openharmony/SDL_openharmony.c b/src/core/openharmony/SDL_openharmony.c
index a8b6872..4d38e96 100644
--- a/src/core/openharmony/SDL_openharmony.c
+++ b/src/core/openharmony/SDL_openharmony.c
@@ -1011,6 +1011,13 @@ static napi_value SDL_JS_UIAbility_OnWindowStageCreate(napi_env env, napi_callba
     napi_value args[] = { CreateNapiString(env, "pages/Index"), CreateNapiFunction(env, NULL, SDL_JS_LoadContentResult, NULL) };
     CallNapiMethod(env, windowStage, "loadContent", SDL_arraysize(args), args);
 
+    // Hide the system status bar and the navigation bar. Huawei's guidance for this is to call
+    // setWindowSystemBarEnable() during onWindowStageCreate -- which is exactly where we are, and
+    // the window reference has just been taken above. Doing it from anywhere else (a timer in the
+    // app, or the immersive-mode APIs) gets overridden by the system a moment later, which leaves
+    // the status bar drawn on top of a fullscreen game.
+    SDL_OpenHarmonyToggleSystemBars(false, false);
+
     return GetNapiUndefined(env);
 }
 
diff --git a/src/video/openharmony/SDL_openharmonyvideo.c b/src/video/openharmony/SDL_openharmonyvideo.c
index 63ab3db..4708365 100644
--- a/src/video/openharmony/SDL_openharmonyvideo.c
+++ b/src/video/openharmony/SDL_openharmonyvideo.c
@@ -70,6 +70,7 @@ void SDL_OpenHarmonyGetNativeWindowPointers(void **xcomponent, void **window)
 
 void SDL_OpenHarmonyVideoSurfaceDestroyed(void *component, void *window)
 {
+    SDL_Log("OPENHARMONY-DEBUG: OnSurfaceDestroyed component=%p window=%p", component, window);
     SDL_assert(native_xcomponent == ((OH_NativeXComponent *) component));  // right now we assume one surface, one window.
     native_xcomponent = NULL;
     native_window = NULL;
@@ -85,6 +86,7 @@ void SDL_OpenHarmonyVideoSurfaceChanged(void *component, void *window)
 
 void SDL_OpenHarmonyVideoSurfaceCreated(void *component, void *window)
 {
+    SDL_Log("OPENHARMONY-DEBUG: OnSurfaceCreated component=%p window=%p", component, window);
     SDL_assert(native_xcomponent == NULL);  // right now we assume one surface, one window.
     native_xcomponent = (OH_NativeXComponent *) component;
     native_window = window;
diff --git a/src/video/openharmony/SDL_openharmonywindow.c b/src/video/openharmony/SDL_openharmonywindow.c
index f462d9d..d616c93 100644
--- a/src/video/openharmony/SDL_openharmonywindow.c
