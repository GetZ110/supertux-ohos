+/* Register the touch device up front, the way the Android backend does in
+   Android_InitTouch() (called from Android_VideoInit).
+
+   On OpenHarmony the only SDL_AddTouch() call is the one inside
+   SDL_OpenHarmonyDispatchTouchEvent(), i.e. it happens lazily on the *first* finger event. That
+   makes SDL_GetTouchDevices() report zero devices during start-up, which is exactly when apps
+   probe for touch support -- SuperTux does:
+
+       SDL_GetTouchDevices(&num_touch_devices);
+       g_config->mobile_controls = (num_touch_devices > 0);
+
+   so it concluded "no touchscreen" on a phone and never enabled its on-screen controls. Worse,
+   MobileController::process_finger_*_event() scales the finger position by m_screen_width/height,
+   which are only assigned from MobileController::draw() -- and that returns early when
+   mobile_controls is false. Every touch therefore became (0,0) and produced no usable input:
+   taps looked completely dead.
+
+   Registering eagerly means the device is already known at start-up, so the touchscreen is
+   detected and the position scaling has real dimensions. The lazy call in the dispatch path stays
+   as a fallback for the first event. */
+void OPENHARMONY_InitTouch(void)
+{
+    SDL_AddTouch((SDL_TouchID)1, SDL_TOUCH_DEVICE_DIRECT, "OpenHarmony Touch");
+}
+
 void SDL_OpenHarmonyDispatchTouchEvent(void *component, void *window)
 {
     OH_NativeXComponent *xcomponent = (OH_NativeXComponent *) component;
