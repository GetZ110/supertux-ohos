@@ -59,6 +59,7 @@ bool OPENHARMONY_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_Pr
     void *voidxcomp, *native_window;
     SDL_OpenHarmonyGetNativeWindowPointers(&voidxcomp, &native_window);
     OH_NativeXComponent *native_xcomponent = (OH_NativeXComponent *) voidxcomp;
+    SDL_Log("OPENHARMONY-DEBUG: CreateWindow xcomponent=%p native_window=%p", (void *) native_xcomponent, native_window);
     if (!native_xcomponent || !native_window) {
         result = SDL_SetError("Don't have Native XComponent or Native Window");
         goto endfunction;
@@ -114,6 +115,12 @@ bool OPENHARMONY_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_Pr
     window->internal = data;
     OPENHARMONY_Window = window;
 
+    // Hide the system bars again now that the app's window exists. The same call is made from
+    // SDL_JS_UIAbility_OnWindowStageCreate (Huawei's documented place for it), but the system
+    // appears to restore the status bar a couple of seconds into startup -- this second call is
+    // late enough that it should be the last thing to touch that state.
+    SDL_OpenHarmonyToggleSystemBars(false, false);
+
 endfunction:
 
