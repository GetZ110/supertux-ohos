+    SDL_Log("[supertux] paths: base='%s' pref='%s'", SDL_GetBasePath() ? SDL_GetBasePath() : "(null)", pref ? pref : "(null)");
+    if (pref) { SDL_free(pref); }
+
+    const char* probes[] = { "rawtest.txt", "assets://rawtest.txt", "data.zip", "assets://data.zip" };
+    for (const char* probe : probes)
+    {
+      size_t sz = 0;
+      void* data = SDL_LoadFile(probe, &sz);
+      SDL_Log("[supertux] probe SDL_LoadFile('%s') -> %s (%zu bytes) %s", probe, data ? "OK" : "FAILED", sz, data ? "" : SDL_GetError());
