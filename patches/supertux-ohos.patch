+namespace {
+
+/* Font buffers handed out by get_physfs_SDLRWops_memory(). Keyed by filename so
+   that several languages mapping to the same font file (cmn/ja/zh_CN/zh_TW all
+   use NotoSansCJKjp-Medium.otf) share one copy. Never evicted: SuperTux's fonts
+   are a handful of files, and the alternative -- re-inflating a 13.9 MB zip
+   entry per lookup -- is what this exists to avoid. */
+std::map<std::string, std::vector<PHYSFS_uint8>>&
+memory_file_cache()
+{
+  static std::map<std::string, std::vector<PHYSFS_uint8>> cache;
+  return cache;
+}
+
+} // namespace
+
+SDL_IOStream* get_physfs_SDLRWops_memory(const std::string& filename)
+{
+  if (filename.empty()) {
+    throw std::runtime_error("Couldn't open file: empty filename");
+  }
+
+  auto& cache = memory_file_cache();
+  auto it = cache.find(filename);
+  if (it == cache.end())
+  {
+    PHYSFS_file* file = static_cast<PHYSFS_file*>(PHYSFS_openRead(filename.c_str()));
+    if (!file) {
+      std::stringstream msg;
+      msg << "Couldn't open '" << filename << "': "
+          << physfsutil::get_last_error();
+      throw std::runtime_error(msg.str());
+    }
+
+    const PHYSFS_sint64 length = PHYSFS_fileLength(file);
+    if (length < 0) {
+      PHYSFS_close(file);
+      std::stringstream msg;
+      msg << "Couldn't size '" << filename << "': "
+          << physfsutil::get_last_error();
+      throw std::runtime_error(msg.str());
+    }
+
+    std::vector<PHYSFS_uint8> data(static_cast<size_t>(length));
+    if (length > 0) {
+      const PHYSFS_sint64 got = PHYSFS_readBytes(file, data.data(), static_cast<PHYSFS_uint64>(length));
+      if (got != length) {
+        PHYSFS_close(file);
+        std::stringstream msg;
+        msg << "Couldn't read '" << filename << "': "
+            << physfsutil::get_last_error();
+        throw std::runtime_error(msg.str());
+      }
+    }
+    PHYSFS_close(file);
+
+    it = cache.emplace(filename, std::move(data)).first;
+  }
+
+  auto& data = it->second;
+  if (data.empty()) {
+    throw std::runtime_error("Couldn't open file: '" + filename + "' is empty");
+  }
+
+  SDL_IOStream* stream = SDL_IOFromMem(data.data(), data.size());
+  if (!stream) {
+    throw std::runtime_error("Couldn't create a memory stream for '" + filename +
+                             "': " + SDL_GetError());
+  }
+  return stream;
+}
+
