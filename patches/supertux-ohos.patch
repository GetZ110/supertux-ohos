+    launch_game(args);
+  }
+  catch(const std::exception& err)
+  {
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] ohos_init: launch_game() threw: %s", err.what());
+    log_fatal << "HarmonyOS: failed to start SuperTux: " << err.what() << std::endl;
+    return false;
+  }
