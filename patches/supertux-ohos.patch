+//  GNU General Public License for more details.
+//
+//  You should have received a copy of the GNU General Public License
+//  along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+/* HarmonyOS / OpenHarmony entry point.
+ *
+ * SDL3 on this platform cannot use an ANSI main(): SDL takes over the app through ArkTS +
+ * XComponent and then dlopen()s libmain.so and looks up SDL_AppInit / SDL_AppIterate /
+ * SDL_AppEvent / SDL_AppQuit in it (see SDL's src/main/openharmony/SDL_sysmain_runapp.c).
+ * Those four callbacks live here; they drive Main::ohos_init / ohos_iterate / ohos_shutdown,
+ * which is the blocking Main::run() loop split into one-frame pieces.
+ *
+ * SDL_MAIN_USE_CALLBACKS must be defined before any SDL header is included: SDL_main_impl.h
+ * #errors on OpenHarmony without it, and this translation unit deliberately provides no main().
+ */
+
+#define SDL_MAIN_USE_CALLBACKS 1
+
+#include <memory>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+
+#include "supertux/main.hpp"
+#include "supertux/screen_manager.hpp"
+
+namespace {
+/* Same ownership model as src/main.cpp: one Main for the process, created in SDL_AppInit and
+   destroyed in SDL_AppQuit. Manually reset rather than relying on atexit(), for the reason
+   given in src/main.cpp -- atexit handlers run before global destructors and would crash. */
+std::unique_ptr<Main> g_main;
+} // namespace
+
+extern "C" {
+
+SDL_AppResult SDLCALL
+SDL_AppInit(void** appstate, int argc, char* argv[])
+{
+  (void) appstate;
+
+  SDL_Log("[supertux] SDL_AppInit: argc=%d", argc);
+
+  g_main = std::make_unique<Main>();
+  if (!g_main->ohos_init(argc, argv))
+  {
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] SDL_AppInit: ohos_init() failed");
+    g_main.reset();
+    return SDL_APP_FAILURE;
+  }
+
+  SDL_Log("[supertux] SDL_AppInit: ok, entering the frame loop");
+  return SDL_APP_CONTINUE;
+}
+
+SDL_AppResult SDLCALL
+SDL_AppIterate(void* appstate)
+{
+  (void) appstate;
+
+  if (!g_main)
+  {
+    return SDL_APP_FAILURE;
+  }
+
+  // ohos_iterate() runs one ScreenManager::loop_iter() and reports whether any screen is
+  // still on the stack; an empty stack is the normal way SuperTux quits.
+  if (!g_main->ohos_iterate())
+  {
+    SDL_Log("[supertux] SDL_AppIterate: screen stack empty, quitting");
+    return SDL_APP_SUCCESS;
+  }
+
+  return SDL_APP_CONTINUE;
+}
+
+SDL_AppResult SDLCALL
+SDL_AppEvent(void* appstate, SDL_Event* event)
+{
+  (void) appstate;
+
+  if (event)
+  {
+    // Hand the event to the game instead of leaving it in SDL's queue. SDL's main-callback
+    // dispatch drains that queue before SDL_AppIterate runs, and ScreenManager::loop_iter()
+    // can return early (its "not enough time for a game step yet" path) without polling at
+    // all -- so a queue-based bridge would both delay events and deliver them several times.
+    // ScreenManager::process_events() drains this hand-off queue right after
+    // InputManager::update(), because update() flushes the controller state and a control
+    // press processed before it would never reach a menu or screen.
+    ScreenManager::push_ohos_event(*event);
+  }
+
+  return SDL_APP_CONTINUE;
+}
+
+void SDLCALL
+SDL_AppQuit(void* appstate, SDL_AppResult result)
+{
+  (void) appstate;
+  (void) result;
+
+  SDL_Log("[supertux] SDL_AppQuit: result=%d", (int) result);
+
+  if (g_main)
+  {
+    g_main->ohos_shutdown();
+    g_main.reset();
+  }
+}
+
+} // extern "C"
