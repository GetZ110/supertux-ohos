+#ifdef __OHOS__
+/* ---------------------------------------------------------------------------------------
+   HarmonyOS / OpenHarmony entry points.
+
+   SDL3 on this platform cannot use an ANSI main(): SDL gains control of the app through
+   ArkTS + XComponent and then looks up SDL_AppInit/SDL_AppIterate/SDL_AppEvent/SDL_AppQuit
+   inside libmain.so (see docs/README-harmonyos.md and include/SDL3/SDL_main_impl.h in SDL).
+   src/ohos/main_ohos.cpp implements those four callbacks and drives the three functions
+   below; the desktop path (Main::run) is left exactly as it was.
+   --------------------------------------------------------------------------------------- */
+
+bool
+Main::ohos_init(int argc, char** argv)
+{
+  ErrorHandler::set_handlers();
+
+  SDL_Log("[supertux] ohos_init: parsing arguments, setting up PhysFS + config");
+
+#ifdef __OHOS__
+  // Probe how the app package's assets are reachable: RawFile lookups are what data.zip
+  // loading depends on, so log both the base path and a tiny file next to data.zip.
+  {
+    char* pref = SDL_GetPrefPath("SuperTux", "supertux2");
+    SDL_Log("[supertux] paths: base='%s' pref='%s'", SDL_GetBasePath() ? SDL_GetBasePath() : "(null)", pref ? pref : "(null)");
+    if (pref) { SDL_free(pref); }
+
+    const char* probes[] = { "rawtest.txt", "assets://rawtest.txt", "data.zip", "assets://data.zip" };
+    for (const char* probe : probes)
+    {
+      size_t sz = 0;
+      void* data = SDL_LoadFile(probe, &sz);
+      SDL_Log("[supertux] probe SDL_LoadFile('%s') -> %s (%zu bytes) %s", probe, data ? "OK" : "FAILED", sz, data ? "" : SDL_GetError());
+      if (data) { SDL_free(data); }
+    }
+  }
+#endif
+
+  CommandLineArguments args;
+  if (!init_subsystems(argc, argv, args))
+  {
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] ohos_init: init_subsystems() failed");
+    return false;
+  }
+
+  SDL_Log("[supertux] ohos_init: launching the game (data dir mounted)");
+  try
+  {
+    launch_game(args);
+  }
+  catch(const std::exception& err)
+  {
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] ohos_init: launch_game() threw: %s", err.what());
+    log_fatal << "HarmonyOS: failed to start SuperTux: " << err.what() << std::endl;
+    return false;
+  }
+  catch(...)
+  {
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] ohos_init: launch_game() threw an unknown exception");
+    return false;
+  }
+
+  SDL_Log("[supertux] ohos_init: ready (screen manager %s)", m_screen_manager ? "created" : "MISSING");
+
+#ifdef __OHOS__
+  if (m_video_system)
+  {
+    const Size window_size = m_video_system->get_window_size();
+    SDL_Log("[supertux] window size as SuperTux sees it: %dx%d", window_size.width, window_size.height);
+  }
+#endif
+
+  if (m_screen_manager)
+  {
+    // Same as the head of ScreenManager::run(): the initial screen is only queued by
+    // launch_game(), so apply it before we start handing out frames.
+    m_screen_manager->begin();
+    if (m_screen_manager->get_screen_stack().empty())
+    {
+      SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "[supertux] ohos_init: no screen to run");
+      return false;
+    }
+    SDL_Log("[supertux] ohos_init: %d screen(s) on the stack", (int)m_screen_manager->get_screen_stack().size());
+  }
+
+  return m_screen_manager != nullptr;
+}
+
+bool
+Main::ohos_iterate()
+{
+  if (!m_screen_manager || m_screen_manager->get_screen_stack().empty())
+  {
+    return false;
+  }
+
+  // One iteration of what ScreenManager::run() does in a loop on desktop.
+  m_screen_manager->loop_iter();
+
+  return !m_screen_manager->get_screen_stack().empty();
+}
+
+void
+Main::ohos_shutdown()
+{
+  // Same tail as Main::run(): drop the dictionary manager before the subsystems go away,
+  // then let Main's destructor tear the rest down (src/ohos/main_ohos.cpp resets g_main).
+  g_dictionary_manager.reset();
+}
+#endif
