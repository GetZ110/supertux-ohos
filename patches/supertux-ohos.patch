index 000000000..c795cacc9
--- /dev/null
+++ b/src/ohos/main_ohos.cpp
@@ -0,0 +1,123 @@
+//  SuperTux
+//  Copyright (C) 2026 SuperTux on HarmonyOS port contributors
+//
