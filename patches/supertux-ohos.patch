+#if defined(__OHOS__)
+static std::vector<SDL_Event> g_ohos_event_queue;
+static SDL_Mutex* g_ohos_event_mutex = nullptr;
+
+void
+ScreenManager::push_ohos_event(const SDL_Event& event)
+{
+  if (!g_ohos_event_mutex)
+  {
+    g_ohos_event_mutex = SDL_CreateMutex();
+  }
+
+  SDL_LockMutex(g_ohos_event_mutex);
+  g_ohos_event_queue.push_back(event);
+  SDL_UnlockMutex(g_ohos_event_mutex);
+}
+#endif
+
 void
 ScreenManager::process_events()
 {
   m_input_manager.update();
+
+#if defined(__OHOS__)
+  // Drain whatever SDL's main callbacks handed us since the last frame. This has to happen
+  // *after* InputManager::update(): that call flushes the controllers, so a control press set
+  // before it would never be seen by the menu or screen that this frame goes on to update.
+  {
+    std::vector<SDL_Event> queued;
