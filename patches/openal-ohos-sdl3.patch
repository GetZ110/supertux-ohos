diff --git a/CMakeLists.txt b/CMakeLists.txt
index 55644b0..88cfb64 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1184,6 +1184,27 @@ if(ALSOFT_REQUIRE_SDL2 AND NOT SDL2_FOUND)
     message(FATAL_ERROR "Failed to enabled required SDL2 backend")
 endif()
 
+# Check for SDL3 backend
+# Off by default, since it adds a runtime dependency.
+# SDL3 is not looked up with find_package() here: this build usually
+# cross-compiles, so the caller passes SDL3_INCLUDE_DIR/SDL3_LIBRARY explicitly.
+option(ALSOFT_BACKEND_SDL3 "Enable SDL3 backend" OFF)
+option(ALSOFT_REQUIRE_SDL3 "Require SDL3 backend" OFF)
+if(ALSOFT_BACKEND_SDL3)
+    if(SDL3_INCLUDE_DIR AND SDL3_LIBRARY)
+        set(HAVE_SDL3 1)
+        set(ALC_OBJS  ${ALC_OBJS} alc/backends/sdl3.cpp alc/backends/sdl3.h)
+        set(BACKENDS  "${BACKENDS} SDL3,")
+        set(INC_PATHS ${INC_PATHS} ${SDL3_INCLUDE_DIR})
+        set(EXTRA_LIBS ${EXTRA_LIBS} ${SDL3_LIBRARY})
+    else()
+        message(STATUS "Could NOT find SDL3 (set SDL3_INCLUDE_DIR and SDL3_LIBRARY)")
+    endif()
+endif()
+if(ALSOFT_REQUIRE_SDL3 AND NOT HAVE_SDL3)
+    message(FATAL_ERROR "Failed to enabled required SDL3 backend")
+endif()
+
 # Optionally enable the Wave Writer backend
 option(ALSOFT_BACKEND_WAVE "Enable Wave Writer backend" ON)
 if(ALSOFT_BACKEND_WAVE)
