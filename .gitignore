# Build inputs and outputs: regenerated by scripts/fetch-sources.ps1 and the build scripts.
/third_party/
/build/

# Signing material. NEVER commit these: the .p12 is your private key and the .p7b is a
# provisioning profile issued to your developer account.
/signing/
*.p12
*.p7b
*.csr
*.keystore
verify-certchain.cer

# Packaged apps and generated assets.
*.hap
app/*/entry/libs/
app/*/entry/src/main/resources/rawfile/
app/*/entry/build/
app/*/entry/.cxx/
app/*/.hvigor/
app/*/.idea/
app/*/oh_modules/
app/*/local.properties

# Odds and ends.
*.log
*.tmp
Thumbs.db
.DS_Store
